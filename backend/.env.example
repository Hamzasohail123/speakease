# Database
# In production, point DATABASE_URL at Neon's pooler endpoint (host contains "-pooler")
# to avoid exhausting Postgres connections once more than one backend instance runs.
# DIRECT_URL stays on the non-pooled endpoint — Prisma migrate needs a direct connection.
DATABASE_URL="postgresql://user:password@localhost:5432/ai_english_speaker?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/ai_english_speaker?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# AI Services (Phase 2)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# OAuth (Future)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Redis (Upstash) - caching, rate limiting; app degrades gracefully if unset
REDIS_URL="rediss://default:password@your-instance.upstash.io:6379"

# Paddle (billing) - Merchant of Record, used instead of Stripe (Stripe does not
# support Pakistan-incorporated businesses)
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_VENDOR_ID=""
PADDLE_PRICE_ID_PLUS=""
PADDLE_PRICE_ID_PRO=""
