# Server
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# AI Services (Phase 2)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# OAuth (Future)
GOOGLE_CLIENT_ID=""
